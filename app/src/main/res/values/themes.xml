<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.BioLock" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Add these lines -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/primary_dark</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Window background -->
        <item name="android:windowBackground">#C7E1EE</item>

        <!-- Text colors -->
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:editTextColor">@color/primary_dark</item>
        <item name="android:textColorHint">@color/primary_dark</item>
    </style>

    <!-- Face Login Button Style -->
    <style name="buttonFaceLogin" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primary_dark</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Manual Login Button Style -->
    <style name="buttonManualLogin" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/button_border</item>
        <item name="android:textColor">@color/primary_dark</item>
    </style>

    <style name="Theme.BioLock" parent="Base.Theme.BioLock" />
</resources>